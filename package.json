{
  "name": "social-poster",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild components/hero.tsx --bundle --minify --jsx=automatic --format=iife --outfile=dist/origin-component.js && tailwindcss -i components/tailwind.css -o dist/origin-utilities.css --minify",
