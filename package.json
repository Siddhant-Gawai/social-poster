  },
  "dependencies": {"react": "^19.0.0", "react-dom": "^19.0.0"},
  "devDependencies": {"esbuild": "^0.25.0", "tailwindcss": "^4.0.0", "@tailwindcss/cli": "^4.0.0"}
}
